# ==============================================================================
# SIH26100: AI-Powered Integrated Bid Compliance Verification Platform
# Production Environment Configuration Template
# COPY THIS FILE TO .env.production AND FILL IN SECURE PRODUCTION VALUES
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Edge Domain & HTTPS Configuration
# ------------------------------------------------------------------------------
# Fully-qualified domain name (FQDN) where the service will be hosted.
# If testing locally with HTTPS, use 'localhost' (Caddy issues a local self-signed cert).
# In production, set to your registered domain (e.g. 'gem-compliance.gov.in') for automatic Let's Encrypt TLS.
DOMAIN=localhost

# ------------------------------------------------------------------------------
# 2. Production PostgreSQL Credentials
# ------------------------------------------------------------------------------
# Security: Generate strong, random passwords. Never use default/development passwords in production.
POSTGRES_USER=gem_admin
POSTGRES_PASSWORD=replace_with_a_secure_random_production_password_32_chars
POSTGRES_DB=gem_compliance_prod

# Full SQLAlchemy database connection URLs (constructed from credentials above)
# Port 5432 is internal to Docker and never exposed publicly
DATABASE_URL=postgresql+asyncpg://gem_admin:replace_with_a_secure_random_production_password_32_chars@postgres:5432/gem_compliance_prod
SYNC_DATABASE_URL=postgresql://gem_admin:replace_with_a_secure_random_production_password_32_chars@postgres:5432/gem_compliance_prod

# ------------------------------------------------------------------------------
# 3. Database Runtime Guard
# ------------------------------------------------------------------------------
# MUST be false in staging, demo, and production.
# Forces the backend to fail fast if PostgreSQL is unavailable rather than falling back to SQLite.
ALLOW_SQLITE_FALLBACK=false

# ------------------------------------------------------------------------------
# 4. NVIDIA NIM AI Inference API
# ------------------------------------------------------------------------------
# Security: NVIDIA_API_KEY exists ONLY in the backend container environment.
# Never expose to frontend or NEXT_PUBLIC_ variables.
NVIDIA_API_KEY=nvapi-replace_with_valid_nvidia_nim_production_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# ------------------------------------------------------------------------------
# 5. Frontend & Single-Domain Routing
# ------------------------------------------------------------------------------
# In single-domain production deployments with Caddy/Nginx reverse proxy,
# leave empty string to use browser-relative paths (/api/v1/...) and avoid CORS.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_BASE_URL=
